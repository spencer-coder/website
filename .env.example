# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Restart `npm run dev` after any change —
# Vite reads these at build time, not at runtime.
#
# Everything with a VITE_ prefix is PUBLIC. It gets baked into the JavaScript
# bundle that anyone can download. Never put a real secret here.
# ---------------------------------------------------------------------------

# Where the contact form posts. Create a form at https://formspree.io and paste
# its endpoint. If this is left unset the form degrades to a mailto: block
# rather than silently swallowing messages.
VITE_FORMSPREE_ENDPOINT=

# GitHub username used for the live activity section.
VITE_GITHUB_USERNAME=spencer-coder
